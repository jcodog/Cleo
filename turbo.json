{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/prepare-welcome-assets.mjs",
    "scripts/welcome-emoji-notice.txt",
    "scripts/assets/**"
  ],
  "globalEnv": [
    "DISABLE_SYSTEM_FONTS_LOAD",
    "NODE_ENV",
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
    "CLERK_JWT_ISSUER_DOMAIN",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "DISCORD_BOT_CONVEX_SECRET",
    "DISCORD_BOT_TOKEN",
    "CONVEX_URL",
    "PORT"
  ],
  "globalPassThroughEnv": ["VERCEL_URL"],
  "tasks": {
    "@workspace/discord-bot#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@workspace/dashboard#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "public/welcome-assets/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["../../coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
