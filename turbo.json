{
  "$schema": "https://v2-11-8.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/prepare-welcome-assets.mjs",
    "scripts/welcome-emoji-notice.txt",
    "scripts/assets/**"
  ],
  "globalEnv": [
    "DISABLE_SYSTEM_FONTS_LOAD",
    "NODE_ENV",
    "NODE_OPTIONS",
    "NEXT_PUBLIC_CONVEX_URL",
    "EXPO_PUBLIC_CONVEX_URL",
    "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
    "CLERK_JWT_ISSUER_DOMAIN",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "DISCORD_BOT_CONVEX_SECRET",
    "DISCORD_BOT_TOKEN",
    "DISCORD_APPLICATION_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_APPLICATION_PUBLIC_KEY",
    "DISCORD_ROLE_CONNECTION_REDIRECT_URL",
    "DISCORD_TOKEN_ENCRYPTION_KEY",
    "DISCORD_MESSAGE_CONTENT_ENABLED",
    "DISCORD_MODERATION_ENFORCEMENT_ENABLED",
    "TWITCH_MODERATION_ENFORCEMENT_ENABLED",
    "TWITCH_WORKER_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_EXPECTED_ACCOUNT_ID",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_GUILD_PREMIUM_PRICE_ID",
    "STRIPE_TEST_CHECKOUT_ENABLED",
    "STRIPE_CATALOGUE_WRITES_ENABLED",
    "STRIPE_CATALOGUE_MANAGER_IDS",
    "CLEO_DASHBOARD_ORIGIN",
    "CLEO_OFFICIAL_GUILD_ID",
    "CLEO_MANAGED_ROLE_IDS",
    "CLEO_COMMUNITY_UPGRADES_CHANNEL_ID",
    "CLEO_LINKED_ROLES_FAQ_CHANNEL_ID",
    "CLEO_COMMUNITY_ROLES_ENABLED",
    "CLEO_RECOGNITION_ENABLED",
    "CONVEX_URL",
    "PORT"
  ],
  "globalPassThroughEnv": [
    "VERCEL_URL",
    "NODE_EXTRA_CA_CERTS",
    "NODE_USE_SYSTEM_CA"
  ],
  "tasks": {
    "@workspace/mobile#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@workspace/discord-bot#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@workspace/dashboard#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "public/welcome-assets/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["../../coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
