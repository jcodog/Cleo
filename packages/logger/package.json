{
  "name": "@workspace/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx --no-install oxlint -c ../../.oxlintrc.json . --deny-warnings",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=100 --statements=100 --functions=100 --branches=100 --src=src --include=\"src/**/*.ts\" --exclude=\"src/**/*.test.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/packages/logger\" --temp-directory=\"../../.coverage-tmp/packages/logger\" tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
