{
  "name": "@workspace/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=95 --statements=95 --functions=99 --branches=84 --src=src --include=\"src/**/*.ts\" --exclude=\"src/**/*.test.ts\" --reporter=text --reporter=cobertura --reports-dir=coverage tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
