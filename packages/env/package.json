{
  "name": "@workspace/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --src=src --include=\"src/**/*.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/index.ts\" --reporter=text --reporter=cobertura --reports-dir=coverage tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./shared": "./src/shared.ts",
    "./dashboard": "./src/dashboard.ts",
    "./web": "./src/web.ts",
    "./backend": "./src/backend.ts",
    "./discord": "./src/discord.ts",
    "./kick": "./src/kick.ts",
    "./ws": "./src/ws.ts"
  }
}
