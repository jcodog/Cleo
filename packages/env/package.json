{
  "name": "@workspace/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx --no-install oxlint -c ../../.oxlintrc.json . --deny-warnings",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=100 --statements=100 --functions=100 --branches=95 --src=src --include=\"src/**/*.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/index.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/packages/env\" --temp-directory=\"../../.coverage-tmp/packages/env\" tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./shared": "./src/shared.ts",
    "./dashboard": "./src/dashboard.ts",
    "./web": "./src/web.ts",
    "./backend": "./src/backend.ts",
    "./discord": "./src/discord.ts",
    "./kick": "./src/kick.ts",
    "./ws": "./src/ws.ts"
  }
}
