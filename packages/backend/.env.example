# Convex CLI project selection. Copy this selection to packages/backend/.env.local.
CONVEX_DEPLOYMENT=dev:replace-with-your-development-deployment

# The variables below are a reference for the DEVELOPMENT Convex deployment's
# Environment Variables settings. Copying them into .env.local alone does not
# configure hosted Convex functions. Do not commit real credentials.
# Use Cleo Dev Sandbox acct_1RGgwvE1e1YdqDQQ, not another JCoNet business.
STRIPE_SECRET_KEY=sk_test_replace_with_cleo_dev_sandbox_key
STRIPE_EXPECTED_ACCOUNT_ID=acct_1RGgwvE1e1YdqDQQ

# Approved GBP 499/month recurring Cleo Dev Sandbox Price, created for JCN-253.
# Product: prod_VX3KxV0lTiLijQ. Other environments need their own approved pair.
STRIPE_GUILD_PREMIUM_PRICE_ID=price_1UVzEKE1e1YdqDQQ2ET4LiZ4

# Signing secret for the dedicated DEVELOPMENT Convex /stripe-community-webhook
# destination in the same sandbox. Do not use a legacy Svix/live endpoint secret.
STRIPE_WEBHOOK_SECRET=

# Canonical HTTPS dashboard origin used in Stripe return URLs.
# For local testing this must match the browser's origin and be reachable for
# the payment methods being tested. Use an appropriate HTTPS dev domain if needed.
CLEO_DASHBOARD_ORIGIN=https://localhost:3000

# Keep false until the matching keys, approved Price, webhook and Portal are ready.
STRIPE_TEST_CHECKOUT_ENABLED=false

# Existing community authority configuration is also required for purchases.
# This is Cleo's OFFICIAL server, not the independent community buying Premium.
CLEO_OFFICIAL_GUILD_ID=

# Set the matching pk_test_ key as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in
# apps/dashboard/.env.local. Never put STRIPE_SECRET_KEY in that browser app.
