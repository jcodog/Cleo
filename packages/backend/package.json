{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "codegen": "convex codegen",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=100 --statements=100 --functions=100 --branches=100 --src=. --include=\"src/lib/errors.ts\" --include=\"src/lib/ids.ts\" --include=\"src/lib/time.ts\" --include=\"convex/lib/auth.ts\" --include=\"convex/lib/discordGuildEvents.ts\" --include=\"convex/lib/discordModerationActions.ts\" --include=\"convex/lib/discordRestTransport.ts\" --include=\"convex/lib/supportTickets.ts\" --include=\"convex/lib/validators.ts\" --include=\"convex/actions/bot/discord/supportTickets/openOrResume.ts\" --include=\"convex/mutations/bot/discord/supportTickets/openOrResume.ts\" --include=\"convex/mutations/dashboard/discord/guildSupportConfigs/update.ts\" --exclude=\"**/*.test.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/packages/backend\" --temp-directory=\"../../.coverage-tmp/packages/backend\" tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/shared": "workspace:*",
    "convex": "^1.42.3",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "convex-test": "^0.0.54",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/time": "./src/lib/time.ts",
    "./lib/errors": "./src/lib/errors.ts",
    "./lib/ids": "./src/lib/ids.ts",
    "./shared": "./src/shared/index.ts",
    "./shared/onboarding": "./src/shared/onboarding.ts",
    "./convex/_generated/*": "./convex/_generated/*"
  }
}
