    "svix": "^1.93.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "latest",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.3.0",
