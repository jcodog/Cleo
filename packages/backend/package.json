{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "codegen": "convex codegen",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=90 --statements=90 --functions=95 --branches=85 --src=. --include=\"src/lib/**/*.ts\" --include=\"convex/actions/bot/discord/gateway/lib/gatewayGuild.ts\" --include=\"convex/lib/botDiscordProfiles.ts\" --include=\"convex/lib/clerkUserData.ts\" --include=\"convex/lib/discordGuildEvents.ts\" --include=\"convex/lib/discordModerationActions.ts\" --include=\"convex/lib/validators.ts\" --include=\"convex/mutations/bot/discord/guildEvents/record.ts\" --include=\"convex/mutations/bot/discord/moderationActions/record.ts\" --exclude=\"**/*.test.ts\" --exclude=\"src/index.ts\" --exclude=\"src/lib/index.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/packages/backend\" --temp-directory=\"../../.coverage-tmp/packages/backend\" tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/shared": "workspace:*",
    "convex": "^1.42.0",
    "svix": "^1.96.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "latest",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/time": "./src/lib/time.ts",
    "./lib/errors": "./src/lib/errors.ts",
    "./lib/ids": "./src/lib/ids.ts",
    "./shared": "./src/shared/index.ts",
    "./convex/_generated/*": "./convex/_generated/*"
  }
}
