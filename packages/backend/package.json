{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "codegen": "convex codegen",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=10 --statements=10 --functions=32 --branches=46 --src=. --include=\"src/**/*.ts\" --include=\"convex/**/*.ts\" --exclude=\"**/*.test.ts\" --exclude=\"convex/_generated/**\" --exclude=\"convex/auth.config.ts\" --exclude=\"convex/schema.ts\" --exclude=\"src/index.ts\" --exclude=\"src/env/**\" --exclude=\"src/lib/index.ts\" --exclude=\"src/shared/index.ts\" --reporter=text --reporter=cobertura --reports-dir=coverage tsx --test \"src/**/*.test.ts\" \"convex/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/shared": "workspace:*",
    "convex": "^1.42.0",
    "svix": "^1.96.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "latest",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/time": "./src/lib/time.ts",
    "./lib/errors": "./src/lib/errors.ts",
    "./lib/ids": "./src/lib/ids.ts",
    "./shared": "./src/shared/index.ts",
    "./convex/_generated/*": "./convex/_generated/*"
  }
}
