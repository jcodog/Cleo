{
  "name": "@workspace/dashboard",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=100 --statements=100 --functions=100 --branches=100 --src=src/features/discord-guild-workspace --include=\"src/features/discord-guild-workspace/**/*.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/**/index.ts\" --exclude=\"src/features/discord-guild-workspace/types.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/apps/dashboard\" --temp-directory=\"../../.coverage-tmp/apps/dashboard\" tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@clerk/ui": "^1.27.2",
    "@tabler/icons-react": "^3.46.0",
    "@workspace/backend": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/ui": "workspace:*",
    "convex": "^1.42.3",
    "gsap": "^3.15.0",
    "next": "16.3.0-preview.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
