# Local Next.js development only. Copy to apps/dashboard/.env.local.
# See docs/account-billing-environments.md for Vercel Preview/Production.
# All NEXT_PUBLIC_ values are public and frozen into the build. Rebuild after edits.
NEXT_PUBLIC_CONVEX_URL=https://replace-with-development-deployment.convex.cloud
NEXT_PUBLIC_APP_URL=https://localhost:3000
NEXT_PUBLIC_SITE_URL=https://localhost:3001

# Both keys must belong to the same Clerk DEVELOPMENT instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
# Server-only Next.js credential. Never use NEXT_PUBLIC_ for this value.
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Cleo Dev Sandbox acct_1RGgwvE1e1YdqDQQ, matching the Convex STRIPE_SECRET_KEY.
# Needed for Elements only. The purchaser ledger does not require this key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_cleo_dev_sandbox_key
# Stripe secrets, Price approval, webhook signing and checkout flags belong in
# the selected Convex deployment, not Vercel or this file.
