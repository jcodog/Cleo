# Vercel Production environment values for apps/dashboard.
# Never commit real secret values.

NEXT_PUBLIC_CONVEX_URL=https://your-production-deployment.convex.cloud
NEXT_PUBLIC_SITE_URL=https://cleoai.cloud
NEXT_PUBLIC_APP_URL=https://app.cleoai.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Optional Cleo Stripe Elements checkout. Use the matching Cleo test/sandbox
# publishable key during development. Leave blank in production until JCN-242.
# Secret keys and webhook signing secrets belong in Convex, never in this app.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
