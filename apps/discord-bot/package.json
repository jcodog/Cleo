{
  "name": "@workspace/discord-bot",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier -w \"**/*.{ts,json}\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=95 --statements=95 --functions=90 --branches=85 --src=src --include=\"src/classes/**/*.ts\" --include=\"src/loaders/**/*.ts\" --include=\"src/services/**/*.ts\" --include=\"src/utils/**/*.ts\" --include=\"src/handlers/events/interactionCreate.ts\" --include=\"src/handlers/events/clientReady.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/services/convexBotClient.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/apps/discord-bot\" --temp-directory=\"../../.coverage-tmp/apps/discord-bot\" tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "welcome:preview": "tsx --env-file=.env.local src/scripts/sendWelcomePreview.ts",
    "commands:register": "tsx --env-file=.env.local src/scripts/registerCommands.ts",
    "commands:register:guild": "tsx --env-file=.env.local src/scripts/registerCommands.ts --guild",
    "commands:register:global": "tsx --env-file=.env.local src/scripts/registerCommands.ts --global"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@workspace/backend": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/shared": "workspace:*",
    "convex": "^1.42.0",
    "discord.js": "^14.26.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
