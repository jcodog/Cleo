{
  "name": "@workspace/discord-bot",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "runtime-artifact.json"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "start:production": "node --enable-source-maps dist/index.js",
    "build": "node scripts/build.mjs",
    "lint": "bunx --no-install oxlint -c ../../.oxlintrc.json . --deny-warnings",
    "format": "prettier -w \"**/*.{ts,json}\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --all --check-coverage --lines=100 --statements=100 --functions=100 --branches=100 --src=src --include=\"src/classes/Command.ts\" --include=\"src/classes/Event.ts\" --include=\"src/deployment/validateReleaseArtifact.ts\" --include=\"src/loaders/loadCommands.ts\" --include=\"src/loaders/loadEvents.ts\" --include=\"src/handlers/events/interactionCreate.ts\" --include=\"src/runtime/startup.ts\" --include=\"src/services/guildEventLogging.ts\" --include=\"src/services/guildStatus.ts\" --include=\"src/services/supportTickets.ts\" --include=\"src/utils/createGuildSnapshot.ts\" --exclude=\"src/**/*.test.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=\"../../coverage/apps/discord-bot\" --temp-directory=\"../../.coverage-tmp/apps/discord-bot\" tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "welcome:preview": "tsx --env-file=.env.local src/scripts/sendWelcomePreview.ts",
    "commands:register": "tsx --env-file=.env.local src/scripts/registerCommands.ts",
    "commands:register:guild": "tsx --env-file=.env.local src/scripts/registerCommands.ts --guild",
    "commands:register:global": "tsx --env-file=.env.local src/scripts/registerCommands.ts --global",
    "commands:register:production": "node --enable-source-maps dist/scripts/registerCommands.js --global"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/backend": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "convex": "^1.45.0",
    "esbuild": "^0.28.2",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "^4.5.2"
  }
}
