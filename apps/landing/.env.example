# Production. Use the existing Cleo production Clerk application public key.
NEXT_PUBLIC_SITE_URL=https://cleoai.cloud
NEXT_PUBLIC_APP_URL=https://app.cleoai.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<production Clerk publishable key>

# Local origins may be omitted or overridden. A matching dashboard development
# Clerk publishable key is still required. Never put CLERK_SECRET_KEY here.
# Preview APP_URL must point to the paired dashboard preview, not dev.cleoai.cloud.
# Match the dashboard Clerk instance. Generated vercel.app smoke previews use
# development keys; session parity requires approved same-root preview domains
# using the existing production instance. See docs/web-app-split.md.
# Vercel requires configured cross-app origins. No Convex/provider/runtime secrets.

