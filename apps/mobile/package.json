{
  "name": "@workspace/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "build": "expo export --platform ios --platform android",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "build:ios:unsigned": "bash ../../scripts/build-mobile-ios-unsigned.sh",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --no-install oxlint -c ../../.oxlintrc.json . --deny-warnings",
    "format": "prettier --write .",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --check-coverage --lines=100 --statements=100 --functions=100 --branches=100 --all --src=src/lib --include=\"src/lib/**/*.ts\" --exclude=\"src/**/*.test.ts\" --reporter=text --reporter=html --reporter=cobertura --reports-dir=../../coverage/apps/mobile --temp-directory=../../.coverage-tmp/apps/mobile node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\"",
    "check:expo": "expo install --check"
  },
  "dependencies": {
    "@clerk/expo": "4.14.4",
    "@workspace/backend": "workspace:*",
    "convex": "^1.48.0",
    "expo": "58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "~6.0.3"
  }
}
