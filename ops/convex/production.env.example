# Enter these in the production Convex deployment environment.
# This is a reference template, not a file read by Convex production.

CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
DISCORD_BOT_CONVEX_SECRET=replace-with-the-same-value-used-on-the-vps
DISCORD_BOT_TOKEN=replace-with-the-production-discord-bot-token
DISCORD_APPLICATION_ID=replace-with-the-discord-application-id

# Recommended for the dashboard server-install flow.
DISCORD_CLIENT_ID=replace-with-the-discord-client-id
DISCORD_BOT_PERMISSIONS=replace-with-the-approved-decimal-permissions-value

# Optional when the Discord install flow requires an explicit redirect URI.
# DISCORD_INSTALL_REDIRECT_URI=https://cleoai.cloud/replace-with-approved-route

# Not required for Discord v3.0.0 unless billing is enabled in production.
