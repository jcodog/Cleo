#!/usr/bin/env bash
set -euo pipefail
[[ $# == 0 && "$(id -un)" == cleo ]] || exit 1
env_file=/etc/cleo/twitch-bot.env
grant=/var/lib/cleo-twitch/bot.twitch-grant.json
[[ -f "$env_file" && ! -L "$env_file" && "$(stat -c %U:%G:%a "$env_file")" == root:cleo:640 ]] || exit 1
[[ -d /var/lib/cleo-twitch && ! -L /var/lib/cleo-twitch && "$(stat -c %U:%G:%a /var/lib/cleo-twitch)" == cleo:cleo:700 ]] || exit 1
[[ -f "$grant" && ! -L "$grant" && "$(stat -c %U:%G:%a "$grant")" == cleo:cleo:600 ]] || exit 1
