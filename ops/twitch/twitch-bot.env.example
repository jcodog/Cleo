# Populate through a secure operator channel. Never commit the real file.
NODE_ENV=production
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USER_ID=
TWITCH_BOT_GRANT_PATH=/var/lib/cleo-twitch/bot.twitch-grant.json
# Optional, used only by the explicit smoke command. Runtime is multi-broadcaster.
TWITCH_BOOTSTRAP_BROADCASTER_USER_ID=
TWITCH_EVENTSUB_CALLBACK_URL=
TWITCH_EVENTSUB_SECRET=
# HTTPS callback must end in /eventsub. Match the Convex control-plane configuration.
# Authenticates event reservations, stream delivery and revocation reports only.
TWITCH_WORKER_SECRET=
CONVEX_URL=
# Internal loopback listener. The reviewed HTTPS ingress proxies only /eventsub.
TWITCH_WEBHOOK_PORT=8087
TWITCH_READINESS_PATH=/run/cleo-twitch/state.json
TWITCH_HTTP_TIMEOUT_MS=10000
