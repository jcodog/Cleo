Cmnd_Alias CLEO_DISCORD_SYSTEMD = \
  /usr/bin/systemctl restart cleo-discord.service, \
  /usr/bin/systemctl stop cleo-discord.service, \
  /usr/bin/systemctl start cleo-discord-register-commands.service, \
  /usr/bin/systemctl reset-failed cleo-discord-register-commands.service

Cmnd_Alias CLEO_DISCORD_CHECKS = \
  /usr/bin/test -r /etc/cleo/discord-bot.env, \
  /usr/bin/test -w /srv/cleo/discord-bot, \
  /usr/bin/test -w /srv/cleo/discord-bot/releases, \
  /usr/bin/test -w /srv/cleo/discord-bot/shared, \
  /usr/bin/test -w /srv/cleo/discord-bot/shared/deployment.lock, \
  /usr/bin/test -w /srv/cleo/discord-bot/shared/deployment-state.env, \
  /usr/bin/test -w /srv/cleo/discord-bot/current, \
  /usr/local/libexec/cleo/check-discord-env /etc/cleo/discord-bot.env, \
  /usr/local/libexec/cleo/check-discord-runtime *

github-runner ALL=(root) NOPASSWD: CLEO_DISCORD_SYSTEMD
github-runner ALL=(cleo) NOPASSWD: CLEO_DISCORD_CHECKS
